# Neon Postgres (provided automatically when the Neon integration is connected)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Stripe — get keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CHECKOUT_ENABLED=false

# 32 random bytes as 64 hex characters. Store separately from the database.
# Never rotate this key without migrating the encrypted credentials.
PAYMENT_CREDENTIALS_KEY=
# PayPal is disabled until live credentials and webhook setup are verified.
PAYPAL_CHECKOUT_ENABLED=false
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Admin access. Use a long random string.
ADMIN_PASSWORD=
RESEND_API_KEY=
SUPPORT_EMAIL=
RESEND_FROM=

# Public site URL, used for Stripe redirect URLs and canonical tags
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Cloud OAuth web client. Register
# https://kingdomcustomprint.com/api/account/google/callback
# as an authorized redirect URI (and localhost equivalent for local testing).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Optional: imgix source host — turns on hosted background removal in the
# editor (e.g. kingdom-cutout.imgix.net). Leave empty to keep removal entirely
# on-device.
NEXT_PUBLIC_IMGIX_SOURCE=

# Optional, evaluation only: name a second engine to offer as a comparison row
# in the image editor ("photoroom"). Leave empty in production — shoppers get
# exactly one Remove Background switch. Set together with PHOTOROOM_API_KEY.
NEXT_PUBLIC_CUTOUT_ALT=

# Server-side key for the Photoroom comparison engine. Never expose it to the
# browser (no NEXT_PUBLIC_ prefix); the editor posts photos to
# /api/photoroom-cutout, which holds the key.
PHOTOROOM_API_KEY=

# Optional: override the Photoroom service base (tests point this at a local
# mock so no credits are spent).
PHOTOROOM_API_URL=
