# Neon Postgres (provided automatically when the Neon integration is connected)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Stripe — get keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Admin access. Use a long random string.
ADMIN_PASSWORD=

# Public site URL, used for Stripe redirect URLs and canonical tags
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: imgix source domain for the /cutout-compare evaluation page
# (e.g. kingdom-cutout.imgix.net). Leave empty to type it on the page.
NEXT_PUBLIC_IMGIX_SOURCE=