{
  "name": "kingdom-custom-print",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run build:cloudflare",
    "build:next": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "db:seed": "node --env-file=.env.local scripts/seed.mjs",
    "db:seed-additional": "node --env-file=.env.local scripts/seed-additional-catalog.mjs",
    "db:repair-special-images": "node --env-file=.env.local scripts/repair-special-product-images.mjs",
    "db:repair-classic-sizes": "node --env-file=.env.local scripts/repair-classic-tee-sizes.mjs",
    "db:repair-rt2000-variants": "node --env-file=.env.local scripts/repair-rt2000-variants.mjs",
    "images:printed-catalog": "node --env-file=.env.local scripts/generate-printed-catalog.mjs",
    "db:reset": "node --env-file=.env.local scripts/migrate.mjs --force && node --env-file=.env.local scripts/seed.mjs",
    "qa-audit": "node scripts/qa-audit.mjs",
    "qa-cart-flow": "node scripts/qa-cart-flow.mjs",
    "qa-cart-flow:hoodie": "QA_PRODUCT_SLUG=premium-pullover-hoodie QA_PRODUCT_NAME='Premium Pullover Hoodie' node scripts/qa-cart-flow.mjs",
    "qa-admin-flow": "node --env-file-if-exists=.env.local scripts/qa-admin-flow.mjs",
    "qa-customizer-controls": "node scripts/qa-customizer-controls.mjs",
    "qa-canvas-tools": "node scripts/qa-canvas-tools.mjs",
    "qa-customizer-interactions": "node scripts/qa-customizer-interactions.mjs",
    "qa-lumise-library": "node scripts/qa-lumise-library.mjs",
    "qa-customizer-grouping": "node scripts/qa-customizer-grouping.mjs",
    "qa-grouping": "node scripts/qa-grouping.mjs",
    "qa-cutout": "node scripts/qa-cutout.mjs",
    "qa-cutout-mask": "node scripts/qa-cutout-mask.mjs",
    "qa-cutout-actions": "node scripts/qa-cutout-actions.mjs",
    "qa-hosted-cutout": "node scripts/qa-hosted-cutout.mjs",
    "qa-photoroom-cutout": "node scripts/qa-photoroom-cutout.mjs",
    "qa-background-remove": "node scripts/qa-background-remove.mjs",
    "qa-upload-formats": "node scripts/qa-upload-formats.mjs",
    "qa-cutout-ai": "node scripts/qa-cutout-ai.mjs",
    "qa-cutout-lab": "node scripts/qa-cutout-lab.mjs",
    "qa-price-tamper": "node scripts/qa-payments.mjs",
    "qa-garment-families": "node scripts/qa-garment-families.mjs",
    "qa-rt2000-variants": "node scripts/qa-rt2000-variants.mjs",
    "qa-site": "npm run qa-storefront && npm run qa-product-gallery && npm run qa-audit && npm run qa-garment-families && npm run qa-customizer-controls && npm run qa-customizer-interactions && npm run qa-grouping && npm run qa-customizer-grouping && npm run qa-cutout && npm run qa-cutout-mask && npm run qa-cutout-actions && npm run qa-background-remove && npm run qa-upload-formats && npm run qa-cart-flow && npm run qa-payments",
    "qa-storefront": "node scripts/qa-storefront.mjs",
    "qa-payments": "node scripts/qa-payments.mjs",
    "qa-order-payment-replay": "node --env-file=.env.local scripts/qa-order-payment-replay.mjs",
    "qa-order-privacy": "node --env-file=.env.local scripts/qa-order-privacy.mjs",
    "qa-checkout-idempotency": "node --env-file=.env.local scripts/qa-checkout-idempotency.mjs",
    "qa-order-transitions": "node --env-file=.env.local scripts/qa-order-transitions.mjs",
    "qa-account-flow": "node --env-file=.env.local scripts/qa-account-flow.mjs",
    "qa-slow-network": "node scripts/qa-slow-network.mjs",
    "qa-product-gallery": "node scripts/qa-product-gallery.mjs",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "build:cloudflare": "npm run build:vinext && node scripts/prepare-cloudflare-assets.mjs",
    "start:vinext": "vite preview",
    "deploy:vinext": "npm run build:cloudflare && vinext-cloudflare deploy --skip-build"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "@vinext/cloudflare": "1.2.1",
    "google-auth-library": "^10.9.1",
    "heic-to": "^1.6.6",
    "jose": "^6.2.13",
    "next": "16.4.3",
    "postgres": "^3.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-server-dom-webpack": "19.3.1",
    "sharp": "^0.35.5",
    "stripe": "^16.12.0",
    "vinext": "1.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.6",
    "@types/node": "^20.16.11",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "cf": "1.0.0-beta.24",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "playwright": "^1.63.0",
    "typescript": "^5.6.3",
    "vercel": "^62.1.0",
    "vite": "8.3.0"
  },
  "type": "module"
}
