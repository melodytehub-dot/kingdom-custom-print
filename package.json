{
  "name": "kingdom-custom-print",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "db:seed": "node --env-file=.env.local scripts/seed.mjs",
    "db:reset": "node --env-file=.env.local scripts/migrate.mjs --force && node --env-file=.env.local scripts/seed.mjs",
    "qa-garment-families": "node scripts/qa-garment-families.mjs"
  },
  "dependencies": {
    "next": "16.3.8",
    "postgres": "^3.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "stripe": "^16.12.0"
  },
  "devDependencies": {
    "@types/node": "^20.16.11",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "playwright": "^1.63.0",
    "typescript": "^5.6.3",
    "vercel": "^62.1.0"
  }
}
